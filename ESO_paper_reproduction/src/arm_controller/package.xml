<?xml version="1.0"?>
<package format="2">
  <name>arm_controller</name>
  <version>0.1.0</version>
  <description>
    ROS package that configures ros_control PID position controllers for every joint
    of the uav_arm_v4 manipulator model used in the ESO-based reproduction study.
  </description>

  <maintainer email="chenfan.chn@outlook.com">cf</maintainer>
  <author email="chenfan.chn@outlook.com">cf</author>

  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_controller</depend>
  <depend>effort_controllers</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>

  <export>
  </export>
</package>
