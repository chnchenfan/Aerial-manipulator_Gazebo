<?xml version="1.0"?>
<package format="2">
  <name>uav_arm_top</name>
  <version>0.1.0</version>
  <description>
    Launch files to start the PX4 SITL Gazebo simulation together with the uav_arm PID controllers.
  </description>
  <maintainer email="chenfan.chn@outlook.com">cf</maintainer>
  <author email="chenfan.chn@outlook.com">cf</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>roslaunch</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>uav_control</depend>
  <depend>arm_controller</depend>

  <export/>
</package>
