<launch>

  <!-- Arguments for flexibility -->
  <arg name="vehicle" default="uav_arm_v4"/>
  <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/empty.world"/>
  <arg name="namespace" default="uav_arm"/>
  <arg name="gui" default="true"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.5"/>
  <arg name="R" default="0.0"/>
  <arg name="P" default="0.0"/>
  <arg name="Y" default="0.0"/>

  <!-- Load URDF/xacro so gazebo_ros_control can access robot_description-->
  <param name="/robot_description"
       command="$(find xacro)/xacro $(find uav_arm_model)/urdf/uav_arm_v4.urdf.xacro"/>


  <!-- Start PX4 SITL with Gazebo through the upstream launch -->
  <include file="$(find px4)/launch/mavros_posix_sitl.launch">
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="est" value="ekf2"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="R" value="$(arg R)"/>
    <arg name="P" value="$(arg P)"/>
    <arg name="Y" value="$(arg Y)"/>
  </include>

  <!-- Once Gazebo is up, bring up the PID controllers for the arm -->
  <include file="$(find arm_controller)/launch/controller_bringup.launch">
    <arg name="namespace" value="$(arg namespace)"/>
  </include>
</launch>
