<?xml version="1.0"?>
<robot name="uam_v5" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh_path" value="package://uav_arm_model/meshes/uam_v5" />

  <xacro:macro name="effort_transmission" params="joint_name">
    <transmission name="${joint_name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint_name}_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <link name="base_link">
    <inertial>
      <origin xyz="0.01027894 -0.00024771 0.16606907" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02601" ixy="8.015e-05" ixz="-0.00070008"
               iyy="0.02942848" iyz="-8.915e-05" izz="0.04177777"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/base_link.STL"/>
      </geometry>
      <material name="base_grey">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.104 0 0.098434" rpy="-3.1416 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/arm_fix_link.STL"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/base_link.STL"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.104 0 0.098434" rpy="-3.1416 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/arm_fix_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="arm_link1">
    <inertial>
      <origin xyz="0.0 0.013 0.043" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00030" ixy="0" ixz="0"
               iyy="0.00030" iyz="0" izz="0.00015"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="${mesh_path}/arm_link1.STL"/>
      </geometry>
      <material name="arm_grey">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="${mesh_path}/arm_link1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm_joint1" type="continuous">
    <origin xyz="0.104 0 0.098434" rpy="-3.1416 0 0"/>
    <parent link="base_link"/>
    <child link="arm_link1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.12" friction="0.02"/>
  </joint>

  <link name="arm_link2">
    <inertial>
      <origin xyz="0.0913 0.0001 0.0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.00080" ixy="0" ixz="0"
               iyy="0.00120" iyz="0" izz="0.00090"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="${mesh_path}/arm_link2.STL"/>
      </geometry>
      <material name="arm_grey_2">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="${mesh_path}/arm_link2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm_joint2" type="continuous">
    <origin xyz="0 0.02 0.056" rpy="-1.5708 0 0"/>
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.20" friction="0.03"/>
  </joint>

  <link name="left_hand_link">
    <inertial>
      <origin xyz="0.02582393 -0.001 -0.00633685" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="${mesh_path}/left_hand_link.STL"/>
      </geometry>
      <material name="hand_blue">
        <color rgba="0.06 0.71 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="${mesh_path}/left_hand_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hand_joint" type="prismatic">
    <origin xyz="0.19 0.001 -0.0075" rpy="0 0 0"/>
    <parent link="arm_link2"/>
    <child link="left_hand_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.01" upper="0.01" effort="5.0" velocity="0.05"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <link name="right_hand_link">
    <inertial>
      <origin xyz="0.02582393 -0.001 0.00633685" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="${mesh_path}/right_hand_link.STL"/>
      </geometry>
      <material name="hand_blue_right">
        <color rgba="0.06 0.71 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="${mesh_path}/right_hand_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_hand_joint" type="fixed">
    <origin xyz="0.19 0.001 0.0075" rpy="0 0 0"/>
    <parent link="arm_link2"/>
    <child link="right_hand_link"/>
  </joint>

  <xacro:effort_transmission joint_name="arm_joint1"/>
  <xacro:effort_transmission joint_name="arm_joint2"/>
  <xacro:effort_transmission joint_name="left_hand_joint"/>

  <gazebo>
    <plugin name="ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/uav_arm</robotNamespace>
      <robotParam>/robot_description</robotParam>
      <controlPeriod>0.004</controlPeriod>
    </plugin>
  </gazebo>

</robot>
